# voboost-inject.rc — Android init service definition.
#
# The daemon launches at the `on nonencrypted` trigger (fallback `on boot`),
# so it becomes resident BEFORE system_server rises (~18s into boot on the
# target device). This is earlier than sys.boot_completed=1 and lets the
# daemon reconcile/inject system_server targets early.
#
# The service is oneshot + disabled: a crashing daemon does not enter an
# infinite restart loop that would exhaust init's restart budget.
# (The OTA self-update restart behavior uses a different service config at
# the apply boundary — see ota spec "Init hook restarts the daemon on exit".)
#
# The SELinux domain transition (voboost-inject_exec → voboost-inject) is
# owned by selinux-domain (selinux/voboost-inject.te + file_contexts).

on nonencrypted
    # Fallback: if nonencrypted never fires (no FBE), use on boot.
    # The service itself is defined below.

on property:sys.boot_completed=1
    # If nonencrypted was missed, boot_completed is the last-chance trigger.
    # start voboost-inject  # (uncomment if nonencrypted is unreliable on the device)

service voboost-inject /data/voboost-inject/voboost-inject
    class late_start
    user root
    group root
    # The SELinux domain the service enters (owned by selinux-domain).
    seclabel u:r:voboost-inject:s0
    # oneshot: init does not restart on exit (reboot-loop guard).
    # disabled: does not auto-start with class; triggered explicitly above.
    oneshot
    disabled
    # The daemon writes logs and status; give it write access to its zone.
    writepid /data/voboost-inject/run/inject.pid
