{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://voboost.ru/schemas/voboost.schema.json",
  "title": "Voboost product manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "releaseIdentity", "compatibility", "artifacts"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseIdentity": { "$ref": "#/$defs/semver" },
    "compatibility": { "$ref": "#/$defs/compatibility" },
    "artifacts": {
      "type": "array",
      "minItems": 21,
      "maxItems": 1024,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/artifact" },
      "allOf": [{"$ref":"#/$defs/requires-voboost-app"},{"$ref":"#/$defs/requires-voboost-daemon"},{"$ref":"#/$defs/requires-voboost-inject"},{"$ref":"#/$defs/requires-voboost-install"},{"$ref":"#/$defs/requires-voboost-restore"},{"$ref":"#/$defs/requires-voboost-uninstall"},{"$ref":"#/$defs/requires-voboost-selinux"},{"$ref":"#/$defs/requires-voboost-rc"},{"$ref":"#/$defs/requires-restore-json"},{"$ref":"#/$defs/requires-restore-signature"},{"$ref":"#/$defs/requires-implant-arm64"},{"$ref":"#/$defs/requires-implant-arm32"},{"$ref":"#/$defs/requires-agents-json"},{"$ref":"#/$defs/requires-agents-signature"},{"$ref":"#/$defs/requires-agent-common"},{"contains":{"properties":{"role":{"const":"agent-module"}},"required":["role"]},"minContains":1},{"$ref":"#/$defs/requires-qnx-daemon"},{"$ref":"#/$defs/requires-qnx-init"},{"$ref":"#/$defs/requires-qnx-implant"},{"$ref":"#/$defs/requires-qnx-runtime"},{"$ref":"#/$defs/requires-qnx-agent-module"}]
    }
  },
  "$defs": {
    "semver": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$",
      "maxLength": 128
    },
    "positiveProtocol": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
    "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "basename": { "type": "string", "minLength": 1, "maxLength": 255, "pattern": "^(?!\\.{1,2}$)[^/\\\\\\u0000]+$" },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": ["installerProtocol", "operationProtocol", "appDaemonProtocol", "agentCatalogSchema", "agentEntryAbi", "implantAbi"],
      "properties": {
        "installerProtocol": { "$ref": "#/$defs/positiveProtocol" },
        "operationProtocol": { "$ref": "#/$defs/positiveProtocol" },
        "appDaemonProtocol": { "$ref": "#/$defs/positiveProtocol" },
        "agentCatalogSchema": {"const":2},
        "agentEntryAbi": { "$ref": "#/$defs/positiveProtocol" },
        "implantAbi": { "$ref": "#/$defs/positiveProtocol" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "file", "size", "sha256", "activation"],
      "properties": {
        "role": { "enum": ["app","daemon","inject","install","restore","uninstall","selinux","init","restore-authorization","restore-signature","implant","lsplant","agent-catalog","agent-catalog-signature","agent-common","agent-module","qnx-daemon","qnx-init","qnx-implant","qnx-runtime","qnx-agent-module","resource-apk","resource-ledger","qnx-resource-pack","qnx-resource-ledger"] },
        "file": { "$ref": "#/$defs/basename" },
        "size": { "type": "integer", "minimum": 1, "maximum": 134217728 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "activation": { "enum": ["package-installer", "native-runtime", "init", "restore-authority", "agent-generation"] },
        "packageName": {"type":"string"},
        "versionCode": { "type": "integer", "minimum": 1, "maximum": 2100000000 },
        "certificateSha256": { "$ref": "#/$defs/sha256" },
        "abi": { "enum": ["arm64-v8a","armeabi-v7a","qnx-aarch64"] },
        "resource": {"$ref":"#/$defs/resource-metadata"}
      },
      "oneOf": [{"$ref":"#/$defs/app"},{"$ref":"#/$defs/daemon"},{"$ref":"#/$defs/inject"},{"$ref":"#/$defs/install"},{"$ref":"#/$defs/restore"},{"$ref":"#/$defs/uninstall"},{"$ref":"#/$defs/selinux"},{"$ref":"#/$defs/init"},{"$ref":"#/$defs/restore-authorization"},{"$ref":"#/$defs/restore-signature"},{"$ref":"#/$defs/implant-arm64"},{"$ref":"#/$defs/implant-arm32"},{"$ref":"#/$defs/lsplant-arm64"},{"$ref":"#/$defs/lsplant-arm32"},{"$ref":"#/$defs/agent-catalog"},{"$ref":"#/$defs/agent-catalog-signature"},{"$ref":"#/$defs/agent-common"},{"$ref":"#/$defs/agent-module"},{"$ref":"#/$defs/qnx-daemon"},{"$ref":"#/$defs/qnx-init"},{"$ref":"#/$defs/qnx-implant"},{"$ref":"#/$defs/qnx-runtime"},{"$ref":"#/$defs/qnx-agent-module"},{"$ref":"#/$defs/resource-apk"},{"$ref":"#/$defs/resource-ledger"},{"$ref":"#/$defs/qnx-resource-pack"},{"$ref":"#/$defs/qnx-resource-ledger"}],
      "allOf": [{"if":{"properties":{"role":{"const":"resource-apk"}},"required":["role"]},"then":{},"else":{"not":{"required":["resource"]}}}]
    },
    "app": { "properties": { "role": { "const": "app" }, "file": { "const": "voboost-app.apk" }, "activation": { "const": "package-installer" },
        "packageName": {"const":"ru.voboost"} }, "required": ["packageName", "versionCode", "certificateSha256"], "not": { "required": ["abi"] } },
    "daemon": { "properties": { "role": { "const": "daemon" }, "file": { "const": "voboost-daemon" }, "activation": { "const": "native-runtime" } }, "$ref": "#/$defs/no-extra-metadata" },
    "inject": { "properties": { "role": { "const": "inject" }, "file": { "const": "voboost-inject" }, "activation": { "const": "native-runtime" } }, "$ref": "#/$defs/no-extra-metadata" },
    "install": { "properties": { "role": { "const": "install" }, "file": { "const": "voboost-install" }, "activation": { "const": "native-runtime" } }, "$ref": "#/$defs/no-extra-metadata" },
    "restore": { "properties": { "role": { "const": "restore" }, "file": { "const": "voboost-restore" }, "activation": { "const": "restore-authority" } }, "$ref": "#/$defs/no-extra-metadata" },
    "uninstall": { "properties": { "role": { "const": "uninstall" }, "file": { "const": "voboost-uninstall" }, "activation": { "const": "restore-authority" } }, "$ref": "#/$defs/no-extra-metadata" },
    "selinux": { "properties": { "role": { "const": "selinux" }, "file": { "const": "voboost-selinux" }, "activation": { "const": "native-runtime" } }, "$ref": "#/$defs/no-extra-metadata" },
    "init": { "properties": { "role": { "const": "init" }, "file": { "const": "voboost.rc" }, "activation": { "const": "init" } }, "$ref": "#/$defs/no-extra-metadata" },
    "restore-authorization": { "properties": { "role": { "const": "restore-authorization" }, "file": { "const": "restore.json" }, "activation": { "const": "restore-authority" }, "size": { "maximum": 4194304 } }, "$ref": "#/$defs/no-extra-metadata" },
    "restore-signature": { "properties": { "role": { "const": "restore-signature" }, "file": { "const": "restore.json.sig" }, "activation": { "const": "restore-authority" }, "size": { "const": 64 } }, "$ref": "#/$defs/no-extra-metadata" },
    "implant-arm64": { "properties": { "role": { "const": "implant" }, "file": { "const": "libimplant-arm64-v8a.so" }, "activation": { "const": "native-runtime" }, "abi": { "const": "arm64-v8a" } }, "required": ["abi"], "$ref": "#/$defs/no-apk-metadata" },
    "implant-arm32": { "properties": { "role": { "const": "implant" }, "file": { "const": "libimplant-armeabi-v7a.so" }, "activation": { "const": "native-runtime" }, "abi": { "const": "armeabi-v7a" } }, "required": ["abi"], "$ref": "#/$defs/no-apk-metadata" },
    "lsplant-arm64": { "properties": { "role": { "const": "lsplant" }, "file": { "const": "liblsplant-arm64-v8a.so" }, "activation": { "const": "native-runtime" }, "abi": { "const": "arm64-v8a" } }, "required": ["abi"], "$ref": "#/$defs/no-apk-metadata" },
    "lsplant-arm32": { "properties": { "role": { "const": "lsplant" }, "file": { "const": "liblsplant-armeabi-v7a.so" }, "activation": { "const": "native-runtime" }, "abi": { "const": "armeabi-v7a" } }, "required": ["abi"], "$ref": "#/$defs/no-apk-metadata" },
    "agent-catalog": { "properties": { "role": { "const": "agent-catalog" }, "file": { "const": "agents.json" }, "activation": { "const": "agent-generation" }, "size": { "maximum": 4194304 } }, "$ref": "#/$defs/no-extra-metadata" },
    "agent-catalog-signature": { "properties": { "role": { "const": "agent-catalog-signature" }, "file": { "const": "agents.json.sig" }, "activation": { "const": "agent-generation" }, "size": { "const": 64 } }, "$ref": "#/$defs/no-extra-metadata" },
    "agent-common": { "properties": { "role": { "const": "agent-common" }, "file": { "const": "agent-common.dex" }, "activation": { "const": "agent-generation" }, "size": { "maximum": 67108864 } }, "$ref": "#/$defs/no-extra-metadata" },
    "agent-module": { "properties": { "role": { "const": "agent-module" }, "file": { "type": "string", "pattern": "^agent-[a-z0-9]+(?:-[a-z0-9]+)*\\.dex$", "not": { "const": "agent-common.dex" } }, "activation": { "const": "agent-generation" }, "size": { "maximum": 67108864 } }, "$ref": "#/$defs/no-extra-metadata" },
    "no-apk-metadata": { "properties": { "size": { "maximum": 67108864 } }, "not": { "anyOf": [{ "required": ["packageName"] }, { "required": ["versionCode"] }, { "required": ["certificateSha256"] }] } },
    "no-extra-metadata": { "allOf": [{ "$ref": "#/$defs/no-apk-metadata" }, { "not": { "required": ["abi"] } }] },
    "requires-voboost-app": { "contains": { "properties": { "file": { "const": "voboost-app.apk" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-daemon": { "contains": { "properties": { "file": { "const": "voboost-daemon" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-inject": { "contains": { "properties": { "file": { "const": "voboost-inject" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-install": { "contains": { "properties": { "file": { "const": "voboost-install" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-restore": { "contains": { "properties": { "file": { "const": "voboost-restore" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-uninstall": { "contains": { "properties": { "file": { "const": "voboost-uninstall" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-selinux": { "contains": { "properties": { "file": { "const": "voboost-selinux" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-voboost-rc": { "contains": { "properties": { "file": { "const": "voboost.rc" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-restore-json": { "contains": { "properties": { "file": { "const": "restore.json" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-restore-signature": { "contains": { "properties": { "file": { "const": "restore.json.sig" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-implant-arm64": { "contains": { "properties": { "file": { "const": "libimplant-arm64-v8a.so" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-implant-arm32": { "contains": { "properties": { "file": { "const": "libimplant-armeabi-v7a.so" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-agents-json": { "contains": { "properties": { "file": { "const": "agents.json" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-agents-signature": { "contains": { "properties": { "file": { "const": "agents.json.sig" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "requires-agent-common": { "contains": { "properties": { "file": { "const": "agent-common.dex" } }, "required": ["file"] }, "minContains": 1, "maxContains": 1 },
    "resource-file": {"type":"object","additionalProperties":false,"required":["file","size","sha256"],"properties":{"file":{"$ref":"#/$defs/basename"},"size":{"type":"integer","minimum":1,"maximum":1048576},"sha256":{"$ref":"#/$defs/sha256"}}},
    "resource-metadata": {"type":"object","additionalProperties":false,"required":["owner","locale","targetPackage","compatibilitySchema","overlayPackage","coverageLedger"],"properties":{"owner":{"const":"i18n-ru"},"locale":{"const":"ru"},"targetPackage":{"type":"string","pattern":"^[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)+$","maxLength":255},"compatibilitySchema":{"const":1},"overlayPackage":{"type":"string","pattern":"^ru\\.voboost\\.translation\\.[A-Za-z][A-Za-z0-9_]*(?:\\.[A-Za-z][A-Za-z0-9_]*)*$","maxLength":255},"coverageLedger":{"$ref":"#/$defs/resource-file"}}},
    "resource-apk": {"properties":{"role":{"const":"resource-apk"},"file":{"type":"string","pattern":"^resource-i18n-ru-[a-z0-9]+(?:-[a-z0-9]+)*\\.apk$","maxLength":149},"activation":{"const":"agent-generation"},"size":{"maximum":16777216}},"required":["packageName","versionCode","certificateSha256","resource"],"not":{"required":["abi"]}},
    "resource-ledger": {"properties":{"role":{"const":"resource-ledger"},"file":{"type":"string","pattern":"^resource-i18n-ru-[a-z0-9]+(?:-[a-z0-9]+)*\\.json$","maxLength":150},"activation":{"const":"agent-generation"},"size":{"maximum":1048576}},"$ref":"#/$defs/no-extra-metadata"},
    "qnx-daemon": {"properties":{"role":{"const":"qnx-daemon"},"file":{"const":"voboost-cluster-daemon"},"activation":{"const":"native-runtime"},"abi":{"const":"qnx-aarch64"}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]},
    "qnx-init": {"properties":{"role":{"const":"qnx-init"},"file":{"const":"voboost-cluster-startup.sh"},"activation":{"const":"init"}},"$ref":"#/$defs/no-apk-metadata","not":{"required":["abi"]}},
    "qnx-implant": {"properties":{"role":{"const":"qnx-implant"},"file":{"const":"libvoboost-cluster-inject.so"},"activation":{"const":"native-runtime"},"abi":{"const":"qnx-aarch64"}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]},
    "qnx-runtime": {"properties":{"role":{"const":"qnx-runtime"},"file":{"const":"libvoboost-runtime-cluster.so"},"activation":{"const":"agent-generation"},"abi":{"const":"qnx-aarch64"}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]},
    "qnx-agent-module": {"properties":{"role":{"const":"qnx-agent-module"},"file":{"type":"string","pattern":"^libagent-[a-z0-9]+(?:-[a-z0-9]+)*\\.so$"},"activation":{"const":"agent-generation"},"abi":{"const":"qnx-aarch64"}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]},
    "requires-qnx-daemon": {"contains":{"properties":{"file":{"const":"voboost-cluster-daemon"}},"required":["file"]},"minContains":1,"maxContains":1},
    "requires-qnx-init": {"contains":{"properties":{"file":{"const":"voboost-cluster-startup.sh"}},"required":["file"]},"minContains":1,"maxContains":1},
    "requires-qnx-implant": {"contains":{"properties":{"file":{"const":"libvoboost-cluster-inject.so"}},"required":["file"]},"minContains":1,"maxContains":1},
    "requires-qnx-runtime": {"contains":{"properties":{"file":{"const":"libvoboost-runtime-cluster.so"}},"required":["file"]},"minContains":1,"maxContains":1},
    "requires-qnx-agent-module": {"contains":{"properties":{"file":{"const":"libagent-font-cyrillic.so"}},"required":["file"]},"minContains":1,"maxContains":1},
    "qnx-resource-pack": {"properties":{"role":{"const":"qnx-resource-pack"},"file":{"type":"string","pattern":"^qnx-resource-i18n-ru-[a-z0-9]+(?:-[a-z0-9]+)*\\.kzb$","maxLength":121},"activation":{"const":"agent-generation"},"abi":{"const":"qnx-aarch64"},"size":{"maximum":16777216}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]},
    "qnx-resource-ledger": {"properties":{"role":{"const":"qnx-resource-ledger"},"file":{"type":"string","pattern":"^qnx-resource-i18n-ru-[a-z0-9]+(?:-[a-z0-9]+)*\\.json$","maxLength":122},"activation":{"const":"agent-generation"},"abi":{"const":"qnx-aarch64"},"size":{"maximum":1048576}},"$ref":"#/$defs/no-apk-metadata","required":["abi"]}
  }
}
