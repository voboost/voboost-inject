 ldr x1, [sp, #(2 * 8 + 2 * 8 + 30 * 8 + 8 * 16)]
-adrp TMP_REG_0, cdecl(common_closure_bridge_handler)@PAGE
-add TMP_REG_0, TMP_REG_0, cdecl(common_closure_bridge_handler)@PAGEOFF
-blr TMP_REG_0
+// Direct call via the PLT. Dobby is built WITHOUT -fPIC (see
+// cmake/compiler_and_linker.cmake): it is a static archive later linked into
+// the shared libimplant.so. lld rejects every PC-relative addressing form
+// (ADR_PREL_PG_HI21, R_AARCH64_ABS64 literal-pool "ldr =") against the
+// defined-but-externally-visible handler when linking the static archive into
+// a shared library, and clang 21's integrated-as rejects the @PAGE/@PAGEOFF
+// form outright ("invalid symbol kind for ADRP relocation"). A direct `bl`
+// emits R_AARCH64_CALL26, which lld resolves through a PLT stub in the shared
+// library — the correct shared-library-safe direct call. The handler's C
+// signature takes (ctx, tramp) in x0/x1, which match the call convention set
+// up above (x0 = sp = ctx, x1 = interceptor entry).
+bl cdecl(common_closure_bridge_handler)
 
