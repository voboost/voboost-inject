+# ndk-build). Compiling Dobby itself with -fPIC makes clang 21's integrated-as
+# reject the closure_bridge_arm64.asm symbol references and produces
+# R_AARCH64_ABS64 relocations against the weak handler symbol that lld then
+# refuses when linking the shared library. Without -fPIC the static archive's
+# ABS64 relocations resolve cleanly at the static-link step into libimplant.so.
+set(CMAKE_C_FLAGS "${CMAKE_C_FLAGS} -fvisibility=hidden -fno-stack-check -fno-stack-protector -fno-exceptions -fno-rtti -fno-common -fno-zero-initialized-in-bss")
 
