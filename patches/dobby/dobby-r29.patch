-PUBLIC extern "C" inline void common_closure_bridge_handler(DobbyRegisterContext *ctx, ClosureTrampoline *tramp) {
+// NOTE: must NOT be `inline` (non-extern-C) here — that gives it internal
+// linkage, which breaks the asm symbol reference. `extern "C" inline` would
+// also leave the symbol's binding dependent on TU. `__attribute__((weak))` is
+// the clean choice: every TU that includes this header may emit the
+// definition, the linker keeps one copy, and the asm references it via a
+// GOT-indirect load (R_AARCH64_LD64_GOT_LO12_NC, see
+// closure_bridge_arm64.asm) — which lld accepts in a shared library regardless
+// of binding (Dobby is built non-PIC; see cmake/compiler_and_linker.cmake).
+PUBLIC extern "C" __attribute__((weak)) void
+common_closure_bridge_handler(DobbyRegisterContext *ctx, ClosureTrampoline *tramp) {
   typedef void (*routing_handler_t)(Interceptor::Entry *, DobbyRegisterContext *);
   auto routing_handler = (routing_handler_t)features::apple::arm64e_pac_strip_and_sign(tramp->carry_handler);
   routing_handler((Interceptor::Entry *)tramp->carry_data, ctx);
