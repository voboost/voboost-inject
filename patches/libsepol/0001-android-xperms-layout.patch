+static void test_expander_keeps_xperms_kinds_separate(void)
+{
+	policydb_t policy;
+	type_datum_t source_type = { .flavor = TYPE_TYPE };
+	type_datum_t target_type = { .flavor = TYPE_TYPE };
+	type_datum_t *types[] = { &source_type, &target_type };
+	ebitmap_t attr_type_map[2];
+	avtab_t source;
+	avtab_t expanded;
+	avtab_key_t key = {
+		.source_type = 1,
+		.target_type = 2,
+		.target_class = 1,
+		.specified = AVTAB_OPNUM_ALLOWED,
+	};
+	avtab_operations_t function_ops = {
+		.specified = AVTAB_XPERMS_IOCTLFUNCTION,
+		.driver = 7,
+		.perms = { 1U << 3 },
+	};
+	avtab_operations_t driver_ops = {
+		.specified = AVTAB_XPERMS_IOCTLDRIVER,
+		.driver = 7,
+		.perms = { 1U << 5 },
+	};
+	avtab_operations_t matching_function_ops = {
+		.specified = AVTAB_XPERMS_IOCTLFUNCTION,
+		.driver = 7,
+		.perms = { 1U << 4 },
+	};
+	avtab_operations_t other_driver_ops = {
+		.specified = AVTAB_XPERMS_IOCTLFUNCTION,
+		.driver = 8,
+		.perms = { 1U << 6 },
+	};
+	avtab_datum_t function_datum = { .ops = &function_ops };
+	avtab_datum_t driver_datum = { .ops = &driver_ops };
+	avtab_datum_t matching_function_datum = { .ops = &matching_function_ops };
+	avtab_datum_t other_driver_datum = { .ops = &other_driver_ops };
+	avtab_ptr_t node;
+	avtab_ptr_t inserted;
+	unsigned int found_function_driver_7 = 0;
+	unsigned int found_function_driver_8 = 0;
+	unsigned int found_driver = 0;
+	int rc;
+
+	memset(&policy, 0, sizeof(policy));
+	memset(&source, 0, sizeof(source));
+	memset(&expanded, 0, sizeof(expanded));
+	ebitmap_init(&attr_type_map[0]);
+	ebitmap_init(&attr_type_map[1]);
+	policy.type_val_to_struct = types;
+	policy.attr_type_map = attr_type_map;
+	rc = avtab_init(&source);
+	CU_ASSERT_EQUAL(rc, 0);
+	if (rc)
+		goto cleanup;
+	rc = avtab_alloc(&source, 4);
+	CU_ASSERT_EQUAL(rc, 0);
+	if (rc)
+		goto cleanup;
+	rc = avtab_init(&expanded);
+	CU_ASSERT_EQUAL(rc, 0);
+	if (rc)
+		goto cleanup;
+	inserted = avtab_insert_nonunique(&source, &key, &function_datum);
+	CU_ASSERT_PTR_NOT_NULL(inserted);
+	if (!inserted)
+		goto cleanup;
+	inserted = avtab_insert_nonunique(&source, &key, &driver_datum);
+	CU_ASSERT_PTR_NOT_NULL(inserted);
+	if (!inserted)
+		goto cleanup;
+	inserted = avtab_insert_nonunique(&source, &key,
+					  &matching_function_datum);
+	CU_ASSERT_PTR_NOT_NULL(inserted);
+	if (!inserted)
+		goto cleanup;
+	inserted = avtab_insert_nonunique(&source, &key, &other_driver_datum);
+	CU_ASSERT_PTR_NOT_NULL(inserted);
+	if (!inserted)
+		goto cleanup;
+	rc = expand_avtab(&policy, &source, &expanded);
+	CU_ASSERT_EQUAL(rc, 0);
+	if (rc)
+		goto cleanup;
+	CU_ASSERT_EQUAL(expanded.nel, 3);
+
+	node = avtab_search_node(&expanded, &key);
+	while (node) {
+		if (node->datum.ops->specified == AVTAB_XPERMS_IOCTLFUNCTION &&
+		    node->datum.ops->driver == 7) {
+			CU_ASSERT_EQUAL(node->datum.ops->perms[0],
+					(1U << 3) | (1U << 4));
+			found_function_driver_7++;
+		} else if (node->datum.ops->specified == AVTAB_XPERMS_IOCTLFUNCTION &&
+			   node->datum.ops->driver == 8) {
+			CU_ASSERT_EQUAL(node->datum.ops->perms[0], 1U << 6);
+			found_function_driver_8++;
+		} else if (node->datum.ops->specified == AVTAB_XPERMS_IOCTLDRIVER) {
+			CU_ASSERT_EQUAL(node->datum.ops->driver, 7);
+			CU_ASSERT_EQUAL(node->datum.ops->perms[0], 1U << 5);
+			found_driver++;
+		}
+		node = avtab_search_node_next(node, key.specified);
+	}
+	CU_ASSERT_EQUAL(found_function_driver_7, 1);
+	CU_ASSERT_EQUAL(found_function_driver_8, 1);
+	CU_ASSERT_EQUAL(found_driver, 1);
+
+cleanup:
+	avtab_destroy(&expanded);
+	avtab_destroy(&source);
+	ebitmap_destroy(&attr_type_map[1]);
+	ebitmap_destroy(&attr_type_map[0]);
+}
+
 int expander_add_tests(CU_pSuite suite)
 {
 	if (NULL == CU_add_test(suite, "expander_indexes", test_expander_indexes)) {
@@ -214,5 +332,10 @@ int expander_add_tests(CU_pSuite suite)
 		CU_cleanup_registry();
 		return CU_get_error();
 	}
+	if (NULL == CU_add_test(suite, "expander_xperms_kinds",
+				test_expander_keeps_xperms_kinds_separate)) {
+		CU_cleanup_registry();
+		return CU_get_error();
+	}
 	return 0;
 }
