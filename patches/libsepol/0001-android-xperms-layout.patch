--- a/include/sepol/policydb/avtab.h
+++ b/include/sepol/policydb/avtab.h
@@ -73,8 +73,18 @@ typedef struct avtab_key {
 	uint16_t specified;	/* what fields are specified */
 } avtab_key_t;
 
+/* Extended permissions (ioctl xperms), final upstream on-disk format:
+ * u8 specified, u8 driver, 8 x u32 perms bitmap.  IOCTLFUNCTION selects
+ * individual ioctl functions within a driver; IOCTLDRIVER selects drivers.
+ * f0506h firmware policy v30 uses this format, not the intermediate
+ * brillo OPNUM layout (u8 type + 8 x u32). */
+#define AVTAB_XPERMS_IOCTLFUNCTION	0x01
+#define AVTAB_XPERMS_IOCTLDRIVER		0x02
+/* Compatibility name used by earlier users of this vendored header. */
+#define AVTAB_XPERMS_IOCTL		AVTAB_XPERMS_IOCTLFUNCTION
 typedef struct avtab_operations {
-	uint8_t type;
+	uint8_t specified;
+	uint8_t driver;
 	uint32_t perms[8];
 } avtab_operations_t;
 
