+// Voboost diagnostic callback begin
+namespace voboost_hook_diagnostics {
+using Callback = void (*)(const char *, uint64_t) noexcept;
+static std::atomic<Callback> callback{nullptr};
+static_assert(std::atomic<Callback>::is_always_lock_free);
+
+class Scope {
+public:
+    Scope() noexcept : callback_(callback.load(std::memory_order_acquire)),
+                       started_(callback_ ? Clock::now() : Clock::time_point{}) {}
+    void Emit(const char *stage) const noexcept {
+        if (callback_) {
+            auto elapsed = std::chrono::duration_cast<std::chrono::milliseconds>(
+                Clock::now() - started_).count();
+            callback_(stage, static_cast<uint64_t>(elapsed));
+        }
+    }
+private:
+    using Clock = std::chrono::steady_clock;
+    Callback callback_;
+    Clock::time_point started_;
+};
+
+class Stage {
+public:
+    Stage(const Scope &scope, const char *begin, const char *end) noexcept
+        : scope_(scope), end_(end) {
+        scope_.Emit(begin);
+    }
+    ~Stage() { scope_.Emit(end_); }
+private:
+    const Scope &scope_;
+    const char *end_;
+};
+}
+
+extern "C" __attribute__((visibility("default")))
+void voboost_lsplant_set_stage_callback(voboost_hook_diagnostics::Callback callback) noexcept {
+    voboost_hook_diagnostics::callback.store(callback, std::memory_order_release);
+}
