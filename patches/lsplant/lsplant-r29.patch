--- a/lsplant/src/main/jni/CMakeLists.txt
+++ b/lsplant/src/main/jni/CMakeLists.txt
@@ -5,6 +5,14 @@ find_program(CCACHE ccache)
 
 set(CMAKE_CXX_STANDARD 23)
 
+# Disable ALL LSPlant internal logging globally. LSPlant's __android_log_print
+# calls crash when invoked from inside an ART inline-hook trampoline (format-
+# string pointer corruption). LOG_DISABLED (see logging.hpp) makes every LOG*
+# macro a no-op. Defined here at directory scope so it applies to EVERY
+# translation unit, including C++23 module interface units (.cxx/.ixx) whose
+# BMI generation does not reliably inherit target_compile_definitions.
+add_compile_definitions(LOG_DISABLED)
+
 if (CCACHE)
     set(CMAKE_CXX_COMPILER_LAUNCHER ${CCACHE})
     set(CMAKE_C_COMPILER_LAUNCHER ${CCACHE})
@@ -26,6 +34,14 @@ add_subdirectory(external/dex_builder)
 
 option(LSPLANT_BUILD_SHARED "If ON, lsplant will also build shared library" ON)
 
+# Use a non-empty default even when -DDEBUG_SYMBOLS_PATH= is passed empty on the
+# command line (NOT DEFINED would let an empty value through, and the post-build
+# step would then try to create /${ANDROID_ABI} at the filesystem root, which is
+# read-only). The post-build step strips + splits debug symbols under this path.
+if (NOT DEBUG_SYMBOLS_PATH)
+    set(DEBUG_SYMBOLS_PATH ${CMAKE_BINARY_DIR}/symbols)
+endif()
+
 if (LSPLANT_BUILD_SHARED)
     message(STATUS "Building lsplant as a shared library")
     add_library(${PROJECT_NAME} SHARED ${SOURCES})
