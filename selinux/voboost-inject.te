#
# voboost-inject.te — SELinux policy for the voboost-inject daemon domain.
#
# Defines a dedicated domain `voboost-inject` entered from init via
# init_daemon_domain. The load-bearing rule is:
#
#   allow voboost-inject <target_domains>:process ptrace;
#
# On an Enforcing device, PTRACE_ATTACH from an ordinary domain is denied,
# so without this allow the daemon cannot inject any target. The current
# development emulator runs Permissive, which MASKS this denial — the policy
# MUST be validated on Enforcing hardware before it is considered proven.
#
# This file is compiled with the Android SELinux policy build (sepolicy).
# It is loaded as a vendor or system policy fragment depending on the device.
#

# ---- Type declarations ----

# The daemon process domain.
type voboost-inject;
typeattribute voboost-inject domain;

# The exec type labeled on the daemon binary (via file_contexts).
# init_daemon_domain transitions into voboost-inject when executing this.
type voboost-inject_exec;
typeattribute voboost-inject_exec exec_type;
typeattribute voboost-inject_exec file_type;

# ---- Domain entry from init ----
# When init executes voboost-inject_exec, transition into the voboost-inject domain.
init_daemon_domain(voboost-inject)

# ---- Ptrace allow to target domains ----
# THE LOAD-BEARING RULE. On Enforcing, PTRACE_ATTACH is denied without this.
# The daemon must ptrace every process it injects into.
#
# Target domains cover the processes named in the agent manifest on the
# current device (Android 9 vendor). These are the domains that app and
# system processes run under:
#
#   untrusted_app    — ordinary third-party apps (settings, media, etc.)
#   untrusted_app_25 — apps targeting SDK <= 25
#   platform_app     — platform-signed apps
#   system_app       — system_server and system apps
#   priv_app         — privileged system apps
#   radio            — telephony-related processes
#
# system_server runs in the `system_app` or `system` domain depending on the
# vendor build. The app-viewport agent targets system_server, so both are
# covered.

# App domains (ordinary app targets: launcher, vehiclesetting, media, etc.)
allow voboost-inject untrusted_app:process ptrace;
allow voboost-inject untrusted_app_25:process ptrace;
allow voboost-inject untrusted_app_27:process ptrace;
allow voboost-inject untrusted_app_29:process ptrace;

# Platform / system domains (system_server, privileged system apps)
allow voboost-inject platform_app:process ptrace;
allow voboost-inject system_app:process ptrace;
allow voboost-inject system:process ptrace;
allow voboost-inject priv_app:process ptrace;

# Telephony (bluetoothphone agent target)
allow voboost-inject radio:process ptrace;

# ---- /proc/<pid> read access for target domains ----
# The injector and daemon read /proc/<pid>/maps (bitness detection +
# reconcile marker), /proc/<pid>/cmdline (pid resolution by argv[0]),
# and /proc/<pid>/exe (bitness detection). These reads must succeed
# for the target domains.
allow voboost-inject untrusted_app:file { read open getattr };
allow voboost-inject untrusted_app:dir { search read open };
allow voboost-inject system_app:file { read open getattr };
allow voboost-inject system_app:dir { search read open };
allow voboost-inject system:file { read open getattr };
allow voboost-inject system:dir { search read open };

# ---- Root-zone access (/data/voboost-inject) ----
# The daemon reads/writes manifests, logs, run state, and payload files.
# Only the voboost-inject domain has write access (trust boundary owned by
# provisioning + app-interface).
allow voboost-inject voboost-inject_data_file:dir {
    create read write open add_name remove_name search getattr setattr
};
allow voboost-inject voboost-inject_data_file:file {
    create read write open getattr setattr unlink rename
};

# ---- Process management ----
# The daemon needs to query process info (getpidcon, etc.) for safety checks.
allow voboost-inject self:process { ptrace getsched setsched signal };
allow voboost-inject self:capability { sys_ptrace setuid setgid };

# ---- File system access ----
# Read access to /proc (process listing, maps, cmdline for all targets)
allow voboost-inject proc:dir { search read open };
allow voboost-inject proc:file { read open getattr };

# Access to /data/media (if the shared dir is under the media path)
# and general /data traversal
allow voboost-inject media_rw_data_file:dir {
    search read write open add_name remove_name getattr setattr
};
allow voboost-inject media_rw_data_file:file {
    create read write open getattr setattr unlink rename
};
