[wrap-git]
url = https://github.com/frida/frida-core.git
revision = 17.11.0
directory = frida-core
depth = 1
# voboost-inject patch: frida-core's libc-shim.c gates FRIDA_STDIO_OPAQUE_FILE
# on HAVE_MUSL only, but bionic (Android) also has an opaque/incomplete FILE
# type (struct __sFILE is a forward declaration in the NDK's stdio.h), so
# sizeof(FILE) in frida_file_wrap/frida_file_set_handle fails to compile for
# the Android cross-build. The patch also defines it for HAVE_ANDROID.
#
# voboost-inject patch: lib/agent/meson.build — add --hash-style=sysv to the
# Android agent link args. tools/post-process.py runs termux-elf-cleaner, which
# strips .gnu.hash for old-Android compat but leaves .hash; with the NDK default
# (gnu only) the cleaned agent .so ends up hashless and the API 28 Bionic linker
# rejects it at dlopen: "empty/missing DT_HASH/DT_GNU_HASH (new hash type from
# the future?)". sysv keeps a .hash the cleaner preserves, so older linkers can
# still resolve symbols and target injection succeeds.
diff_files = frida-core-libc-shim-opaque-file-bionic.patch, frida-core-android-agent-link-args.patch

[provide]
dependency_names = frida-core-1.0
