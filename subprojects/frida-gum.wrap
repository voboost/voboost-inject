[wrap-git]
url = https://github.com/frida/frida-gum.git
revision = 17.11.0
directory = frida-gum
depth = 1
# voboost-inject patch: on Android emulators (QEMU) frida-gum's embedded local
# backend reaches gum_query_page_size before gum_cached_page_size is set, so it
# returns 0; (1 + n_pages) * 0 makes gum_alloc_n_pages issue mmap(NULL, 0),
# which QEMU rejects with EINVAL and g_assert aborts the daemon. The patch
# makes gum_query_page_size lazily (re-)query and fall back to 4 KiB so it
# never returns 0, and keeps the size==0 mmap guards. No-op on real devices.
diff_files = frida-gum-qemu-page-size.patch

[provide]
dependency_names = frida-gum-1.0, frida-gum-heap-1.0, frida-gum-prof-1.0, frida-gumjs-1.0, frida-gumjs-inspector-1.0
